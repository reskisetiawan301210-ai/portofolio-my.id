# PILIHAN DATABASE 100% GRATIS SELAMANYA UNTUK BUKU TAMU PORTOFOLIO
# =========================================================================

# PILIHAN 1: Google Firebase Realtime Database (100% Free Google Spark Plan, Tanpa Kartu Kredit)
# Dapatkan URL dari: https://console.firebase.google.com -> Realtime Database
# Contoh:
VITE_FIREBASE_DB_URL=https://reski-portfolio-default-rtdb.firebaseio.com

# PILIHAN 2: Google Sheets / Apps Script (100% Free di Google Drive Anda)
# Contoh URL Web App:
# VITE_GUESTBOOK_API_URL=https://script.google.com/macros/s/AKfycb.../exec

# PILIHAN 3: Supabase (Opsional jika punya slot project gratis)
# VITE_SUPABASE_URL=https://your-project.supabase.co
# VITE_SUPABASE_ANON_KEY=your-anon-key-here
