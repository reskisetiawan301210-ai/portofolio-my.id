# ========================================================
# PENGATURAN SUPABASE BUKU TAMU / KOMENTAR (OPSIONAL)
# ========================================================
# Jika diisi, komentar pengunjung akan tersimpan ke cloud Supabase
# secara global dan langsung terlihat oleh pengunjung lain di mana saja.
# Jika kosong, sistem otomatis berjalan menggunakan mode LocalStorage + Broadcast.
#
# Dapatkan URL dan ANON_KEY dari dashboard Supabase Anda:
# https://supabase.com/dashboard/project/<project-id>/settings/api

VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

